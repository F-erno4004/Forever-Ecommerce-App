# Backend port (optional; defaults to 4000)
PORT=4000

# MongoDB connection string; the application uses the e-commerce database
MONGODB_URI=your_mongodb_connection_string

# Cloudinary account URL for product image uploads
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Long, unique secret used to sign and verify JWTs
JWT_SECRET=replace_with_a_long_random_secret

# Local admin login credentials
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=replace_with_a_strong_password

# Stripe test-mode secret key (required when the backend starts)
STRIPE_SECRET_KEY=your_stripe_test_secret_key